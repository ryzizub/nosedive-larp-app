//
// Runs
//
path /runs {
    read() { true }
    write() { isAuditor() }
}

//
// Nearby users
//

path /users/{run_id} {
    read() { true }
    write() { isAuditor()}
    index() {["delegate", "isVisible", "totalRating"]}
}

//
// User secrets
//

path /userSecrets/{run_id} {
  
    index() {["password"]}

    path /{user_id} is Secret {
      read() { isCurrentUser(user_id) }
      write() { isCurrentUser(user_id) }
    }
}

type Secret {
  password: Password,
  notificationsToken: Token
}

type Password extends String {
    validate() { hasMaxLength(this, 100) }
}

type Token extends String {
    validate() { hasMaxLength(this, 255) }
}

// 
// Ratings
//

path /ratings/{run_id} {
  
  index() {["from", "to"]}
    
  read() { query.orderByChild == "to" && query.equalTo == auth.uid || query.orderByChild == "from" && query.equalTo == auth.uid }

  write() { isAuditor() }

  path /{rating_id} is Rating {
    write() { isInsert(this) && this.from == auth.uid }
  }
}

type Rating {
  from: Id,
  to: Id,
  createdAt: Number,
  stars: Number | Null,
  majorChange: Number | Null,
}

// 
// Reports
//

path /reports/{run_id} {
  read() { isAuditor() }
  write() { isAuditor() }
}

// 
// Posts
//

path /posts/{run_id} {
    
  read() { isSignedIn() }

  write() { isAuditor() }

  path /{post_id} is Post {
    write() { isInsert(this) && this.from == auth.uid }
  }
}

type Post {
  author: Id,
  text: PostText,
  createdAt: Number,
  pictureUrl: Url
}

type PostText extends String {
    validate() { hasMaxLength(this, 9999) }
} 

//
// Common
//

type Id extends String {
    validate() { hasMaxLength(this, 50) }
}

type Url extends String {
    validate() { hasMaxLength(this, 999) }
}

hasMaxLength(text, length) {
    text.length <= length
}

isSignedIn() {
    auth != null
}

isCurrentUser(user_id) {
    isSignedIn() && auth.uid == user_id
}

isInsert(value) {
    prior(value) == null && value != null
}

isAuditor() {
    auth != null && auth.uid == "_karolina"
}